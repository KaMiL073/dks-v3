FROM node:22-alpine AS deps
WORKDIR /workspace/frontend-export
COPY frontend-export/package*.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /workspace/frontend-export

ARG NEXT_PUBLIC_SITE_URL=https://dks.com.pl
ARG NEXT_PUBLIC_DIRECTUS_URL=https://dks.pl/backend
ARG NEXT_PUBLIC_RECAPTCHA_SITE_KEY
ARG NEXT_PUBLIC_RECAPTCHA_BYPASS_LOCAL=false

ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_DIRECTUS_URL=$NEXT_PUBLIC_DIRECTUS_URL
ENV NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY
ENV NEXT_PUBLIC_RECAPTCHA_BYPASS_LOCAL=$NEXT_PUBLIC_RECAPTCHA_BYPASS_LOCAL

COPY --from=deps /workspace/frontend-export/node_modules ./node_modules
COPY frontend-export ./
COPY frontend-new/src/app/globals.css /workspace/frontend-new/src/app/globals.css
COPY ["frontend-new/src/app/(marketing)/HeroSection.tsx", "/workspace/frontend-new/src/app/(marketing)/HeroSection.tsx"]
COPY frontend-new/src/components/navigation /workspace/frontend-new/src/components/navigation
COPY frontend-new/src/components/ui /workspace/frontend-new/src/components/ui
COPY frontend-new/public/static ./public/static

RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /workspace/frontend-export/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /workspace/frontend-export/public ./frontend-export/public
COPY --from=builder --chown=nextjs:nodejs /workspace/frontend-export/.next/static ./frontend-export/.next/static

USER nextjs
WORKDIR /app/frontend-export

EXPOSE 3001

CMD ["node", "server.js"]
