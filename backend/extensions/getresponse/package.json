{
  "name": "getresponse",
  "description": "Synchronizes consenting contact form submissions with GetResponse",
  "icon": "sync",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-hook",
    "getresponse"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.js",
    "host": "^10.10.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "test": "node --test",
    "validate": "directus-extension validate"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^16.0.0"
  }
}
