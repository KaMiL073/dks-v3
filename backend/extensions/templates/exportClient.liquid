<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>DKS Export enquiry confirmation</title>
  </head>
  <body style="margin:0;padding:0;background:#f1f1f1;font-family:Arial,sans-serif;color:#202936;">
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table width="600" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;width:100%;background:#ffffff;">
            <tr>
              <td style="padding:28px 32px;background:#202936;">
                <img src="https://dks.pl/static/logo-dks.svg" width="100" alt="DKS">
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <h1 style="margin:0 0 20px;font-size:24px;">Thank you for contacting DKS Export</h1>
                <p style="line-height:1.6;">Hello {{ data.name }},</p>
                <p style="line-height:1.6;">We have received your enquiry. Our export team will review it and contact you as soon as possible.</p>
                <hr style="margin:28px 0;border:0;border-top:1px solid #d1d5dc;">
                <p><strong>Your message:</strong><br>{{ data.message | newline_to_br }}</p>
                <p style="margin-top:28px;">DKS Export<br><a href="mailto:export.copiers@dks.pl">export.copiers@dks.pl</a></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
