<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>New DKS Export enquiry</title>
  </head>
  <body style="margin:0;padding:0;background:#f1f1f1;font-family:Arial,sans-serif;color:#202936;">
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table width="600" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;width:100%;background:#ffffff;">
            <tr>
              <td style="padding:28px 32px;background:#202936;">
                <img src="https://dks.pl/static/logo-dks.svg" width="100" alt="DKS">
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <h1 style="margin:0 0 24px;font-size:24px;">New export enquiry</h1>
                <p><strong>Name:</strong><br>{{ data.name }}</p>
                <p><strong>Company:</strong><br>{{ data.company }}</p>
                <p><strong>Email:</strong><br><a href="mailto:{{ data.email }}">{{ data.email }}</a></p>
                <p><strong>Phone:</strong><br>{{ data.phone }}</p>
                <p><strong>Country:</strong><br>{{ data.country }}</p>
                <p><strong>Brands:</strong><br>{{ data.brands | join: ", " }}</p>
                <p><strong>Message:</strong><br>{{ data.message | newline_to_br }}</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
